# ============================================================================
# SuccessFactors Employee Central Microservice - Example Configuration
# ----------------------------------------------------------------------------
# SECURITY: copy this file to `.env` and keep `.env` out of version control.
# In production, inject these values via your secret manager (Vault, AWS
# Secrets Manager, Kubernetes secrets, etc.) rather than a flat file.
# ============================================================================

# --- SuccessFactors upstream API ---
# Must be HTTPS (HTTP is only permitted for localhost during development).
SF_API_URL=https://api.successfactors.com
SF_COMPANY_ID=your_company_id
SF_USERNAME=your_username
SF_PASSWORD=your_password

# --- Service API key ---
# REQUIRED. Must be >= 32 characters. Generate with:
#   openssl rand -base64 48
# Clients must present this in the `X-API-Key` header to call protected routes.
SERVICE_API_KEY=CHANGE_ME_generate_with_openssl_rand_base64_48

# --- Server ---
# Default binds to loopback only. Set to 0.0.0.0 behind a reverse proxy/TLS
# terminator only after confirming network-level controls.
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# --- CORS ---
# Comma-separated allowlist. Empty = no cross-origin requests allowed.
# Do NOT use `*` in production.
CORS_ALLOWED_ORIGINS=

# --- Rate limiting ---
# Requests per second per client IP.
RATE_LIMIT_RPS=10

# --- Request limits ---
REQUEST_TIMEOUT_SECS=30
MAX_BODY_BYTES=16384

# --- Logging ---
RUST_LOG=info,successfactors_microservice=info,tower_http=info
