# SuccessFactors API Configuration
# Your SuccessFactors API URL (e.g., https://api.successfactors.com or your datacenter-specific URL)
SF_API_URL=https://api.successfactors.com

# Your SuccessFactors company ID
SF_COMPANY_ID=your_company_id

# SuccessFactors API username
SF_USERNAME=your_username

# SuccessFactors API password
SF_PASSWORD=your_password

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Logging level (optional)
RUST_LOG=successfactors_microservice=debug,tower_http=debug
